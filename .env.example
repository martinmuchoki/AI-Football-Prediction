APP_ENV=development
DATABASE_URL=sqlite:///./data/ai_football.db
AF_API_KEY=
AF_BASE_URL=https://v3.football.api-sports.io
AF_TIMEOUT_SECONDS=20
AF_MAX_RETRIES=3

# Primary current/live provider
LS_API_KEY=
LS_API_SECRET=
LS_BASE_URL=https://livescore-api.com/api-client
LS_TIMEOUT_SECONDS=30
LS_CONNECT_TIMEOUT_SECONDS=10
LS_READ_TIMEOUT_SECONDS=30
LS_WRITE_TIMEOUT_SECONDS=10
LS_POOL_TIMEOUT_SECONDS=10
LS_MAX_RETRIES=4
LS_RETRY_BASE_SECONDS=1
LS_RETRY_MAX_SECONDS=8
LS_MAX_PAGES=50

# league_id:season_start_year
TRACKED_LEAGUES=39:2024
LS_TRACKED_COMPETITIONS=2:2026

FIXTURE_SYNC_EVERY_HOURS=6
RESULT_SYNC_EVERY_MINUTES=60
RESULT_LOOKBACK_HOURS=36
FIXTURE_LOOKBACK_DAYS=1
FIXTURE_LOOKAHEAD_DAYS=7

# Historical CSV provider
FD_BASE_URL=https://www.football-data.co.uk/mmz4281
FD_TIMEOUT_SECONDS=30
FD_MAX_RETRIES=4

# Phase 10A - our API / public web collector
OWN_API_REQUIRE_KEY=false
OWN_API_KEY=
# Comma-separated domains explicitly approved for collection, e.g. example.com,official-league.example
PUBLIC_WEB_ALLOWED_DOMAINS=
PUBLIC_WEB_USER_AGENT=MDRN-SportsQ-Collector/0.10
PUBLIC_WEB_TIMEOUT_SECONDS=20
PUBLIC_WEB_MAX_BODY_BYTES=2000000
PUBLIC_WEB_ROBOTS_FAIL_CLOSED=true
